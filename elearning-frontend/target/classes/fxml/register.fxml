<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.elearning.fx.controller.RegisterController"
      alignment="CENTER" spacing="0" styleClass="login-root"
      prefWidth="1200" prefHeight="750">

    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <!-- Panneau gauche -->
        <VBox alignment="CENTER" spacing="20" styleClass="login-left-panel"
              prefWidth="500" HBox.hgrow="ALWAYS">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
            <Label text="🎓" style="-fx-font-size: 72px;"/>
            <Label text="Rejoignez-nous !" styleClass="login-brand-title"/>
            <Label text="Créez votre compte et commencez à apprendre" styleClass="login-brand-subtitle"/>
        </VBox>

        <!-- Panneau droit formulaire -->
        <VBox alignment="CENTER" spacing="15" styleClass="login-right-panel"
              prefWidth="500" HBox.hgrow="ALWAYS">
            <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

            <VBox spacing="15" alignment="CENTER" maxWidth="380">
                <Label text="Inscription" styleClass="form-title"/>

                <Label fx:id="errorLabel" styleClass="error-label" visible="false"/>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Nom" styleClass="field-label"/>
                        <TextField fx:id="nomField" promptText="Nom" styleClass="text-input"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Prénom" styleClass="field-label"/>
                        <TextField fx:id="prenomField" promptText="Prénom" styleClass="text-input"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField" promptText="votre@email.com" styleClass="text-input"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-input"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="text-input"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Rôle" styleClass="field-label"/>
                    <ComboBox fx:id="roleComboBox" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="levelBox" spacing="5" managed="false" visible="false">
                    <Label text="Niveau d'enseignement" styleClass="field-label"/>
                    <ComboBox fx:id="levelComboBox" styleClass="text-input" maxWidth="Infinity"/>
                </VBox>

                <Button fx:id="registerButton" text="Créer mon compte" onAction="#handleRegister"
                        styleClass="btn-primary" maxWidth="Infinity"/>

                <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="30" prefHeight="30"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Déjà un compte ?" styleClass="small-text"/>
                    <Hyperlink fx:id="loginLink" text="Se connecter" onAction="#handleLoginLink" styleClass="link"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
