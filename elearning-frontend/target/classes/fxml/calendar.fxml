<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.elearning.fx.controller.CalendarController"
      styleClass="page-root" spacing="20" prefWidth="1200" prefHeight="750">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button fx:id="backButton" text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
        <Label text="📅 Calendrier Académique" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addEventButton" text="+ Événement" onAction="#handleAddEvent" styleClass="btn-primary"/>
    </HBox>

    <!-- Navigation mois -->
    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="prevButton" text="◀" onAction="#handlePrevMonth" styleClass="btn-nav"/>
        <Label fx:id="monthYearLabel" styleClass="month-year-label"/>
        <Button fx:id="nextButton" text="▶" onAction="#handleNextMonth" styleClass="btn-nav"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Grille du calendrier -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="scroll-pane">
            <GridPane fx:id="calendarGrid" styleClass="calendar-grid" hgap="2" vgap="2"/>
        </ScrollPane>

        <!-- Événements à venir -->
        <VBox spacing="10" prefWidth="280" styleClass="upcoming-panel">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="📌 À venir" styleClass="section-title"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox fx:id="upcomingEventsBox" spacing="8"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
