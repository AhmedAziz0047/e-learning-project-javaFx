<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.elearning.fx.controller.ChatWindowController"
      styleClass="page-root" spacing="10" prefWidth="500" prefHeight="600">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #16213E; -fx-padding: 10; -fx-background-radius: 8;">
        <Label text="💬 Chat de la séance" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="Déconnecté" style="-fx-text-fill: #A0A4B8; -fx-font-size: 12px;"/>
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane" style="-fx-background-color: transparent;">
        <VBox fx:id="messagesBox" spacing="8">
            <padding><Insets top="10" right="5" bottom="10" left="5"/></padding>
        </VBox>
    </ScrollPane>

    <HBox spacing="10">
        <TextField fx:id="messageField" promptText="Écrivez votre message..." styleClass="text-input" HBox.hgrow="ALWAYS" onAction="#handleSend"/>
        <Button fx:id="sendButton" text="Envoyer" onAction="#handleSend" styleClass="btn-primary"/>
    </HBox>
</VBox>
