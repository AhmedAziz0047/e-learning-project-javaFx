<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.elearning.fx.controller.LoginController"
      alignment="CENTER" spacing="0" styleClass="login-root"
      prefWidth="1200" prefHeight="750">

    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <!-- Panneau gauche décoratif -->
        <VBox alignment="CENTER" spacing="20" styleClass="login-left-panel"
              prefWidth="500" HBox.hgrow="ALWAYS">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
            <Label text="🎓" style="-fx-font-size: 72px;"/>
            <Label text="Plateforme E-Learning" styleClass="login-brand-title"/>
            <Label text="Apprenez, enseignez, progressez." styleClass="login-brand-subtitle"/>
        </VBox>

        <!-- Panneau droit formulaire -->
        <VBox alignment="CENTER" spacing="20" styleClass="login-right-panel"
              prefWidth="500" HBox.hgrow="ALWAYS">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

            <VBox fx:id="loginBox" spacing="20" alignment="CENTER" maxWidth="350">
                <Label text="Connexion" styleClass="form-title"/>

                <Label fx:id="errorLabel" styleClass="error-label" visible="false"/>

                <VBox spacing="5">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField" promptText="votre@email.com" styleClass="text-input"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-input"
                                   onAction="#handleLogin"/>
                </VBox>

                <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin"
                        styleClass="btn-primary" maxWidth="Infinity"/>

                <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="30" prefHeight="30"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Pas encore de compte ?" styleClass="small-text"/>
                    <Hyperlink fx:id="registerLink" text="S'inscrire" onAction="#handleRegisterLink"
                               styleClass="link"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
